hikoboshi_weights_sources = files(
  'manifest.cpp',
  'provider.cpp',
  'embedded_mpnn_d64.cpp',
  'embedded_esm2_8m.cpp',
  'embedded_proteinmpnn_v48_eps020.cpp',
)

# Large generated byte-literal blobs are compiled with -O0 and the
# warning lane disabled so the compiler does not waste cycles
# optimizing or auditing a 30 MB static array. The ESM2-8M blob
# expands to ~190 MB of C++ source; the MPNN-64 blob shares the lane
# for consistency. Symbols are declared `alignas(64) extern const
# std::uint8_t[...]` in the matching generated header, so the embedded
# bridge TU links against this sub-library through the dependency
# declared in the root build file.
hikoboshi_blob_generator = meson.project_source_root() / 'tools/generate_embedded_blob.py'

hikoboshi_esm2_8m_blob_source = custom_target(
  'generate_esm2_8m_blob',
  input: meson.project_source_root() / 'weights/Hikoboshi-ESM2-8M.safetensors',
  output: 'esm2_8m_blob.cpp',
  command: [
    codegen_python,
    hikoboshi_blob_generator,
    '--input', '@INPUT@',
    '--output', '@OUTPUT@',
    '--header', 'esm2_8m_blob.hpp',
    '--namespace', 'hikoboshi::weights::generated::esm2_8m',
    '--sha256', '7b1fea896ddbe6abb41e0f171cd1f9cce74868fbe44563afb87f3b176ccaca03',
  ],
)

hikoboshi_proteinmpnn_blob_source = custom_target(
  'generate_proteinmpnn_v48_eps020_blob',
  input: meson.project_source_root() / 'weights/Hikoboshi-ProteinMPNN-v48-020.safetensors',
  output: 'proteinmpnn_v48_eps020_blob.cpp',
  command: [
    codegen_python,
    hikoboshi_blob_generator,
    '--input', '@INPUT@',
    '--output', '@OUTPUT@',
    '--header', 'proteinmpnn_v48_eps020_blob.hpp',
    '--namespace', 'hikoboshi::weights::generated::proteinmpnn_v48_eps020',
    '--sha256', '342b52ae248f2b70b2059313bab5ae7a358cbabac940072f71f5907eeaa21536',
  ],
)

hikoboshi_weights_blob_sources = [
  files('generated/mpnn_d64_blob.cpp'),
  hikoboshi_esm2_8m_blob_source,
  hikoboshi_proteinmpnn_blob_source,
]
